# SSO Service Environment Variables
# Copy to .env and fill in values

# Database (use the same PostgreSQL as entro.ly)
DATABASE_URL="postgresql://user:password@localhost:5432/entropi_sso"

# JWT Keys (RS256)
# Generate with: openssl genrsa -out private.pem 2048
# Then: openssl rsa -in private.pem -pubout -out public.pem
# Paste content as single line, replacing newlines with \n
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# TikTok Login Kit (OAuth)
# 1. At https://developers.tiktok.com/ → your app → add "Login Kit" product
# 2. In Login Kit → Redirect URI (Web): add the EXACT URI (TikTok requires exact match).
#    Option A – use entro.ly path (this repo has route at /auth/tiktok/callback):
TIKTOK_REDIRECT_URI="https://entro.ly/auth/tiktok/callback"
#    Option B – use SSO subdomain (omit TIKTOK_REDIRECT_URI and set NEXT_PUBLIC_SSO_URL):
#    https://sso.entro.ly/api/auth/tiktok/callback
#    Local: http://localhost:3000/api/auth/tiktok/callback or http://localhost:3000/auth/tiktok/callback
# 3. Copy Client Key and Client Secret (no quotes/spaces in .env value)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# SSO base URL – production: https://sso.entro.ly (untuk TikTok redirect_uri)
NEXT_PUBLIC_SSO_URL="https://sso.entro.ly"

# Environment (production / development)
NODE_ENV="production"
