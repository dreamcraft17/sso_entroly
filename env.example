# SSO Service Environment Variables
# Copy to .env and fill in values

# Database (use the same PostgreSQL as entro.ly)
DATABASE_URL="postgresql://user:password@localhost:5432/entropi_sso"

# JWT Keys (RS256)
# Generate with: openssl genrsa -out private.pem 2048
# Then: openssl rsa -in private.pem -pubout -out public.pem
# Paste content as single line, replacing newlines with \n
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Environment
NODE_ENV="development"
